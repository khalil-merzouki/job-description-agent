{
  "name": "job-description-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env index.tsx",
    "start:api": "tsx --env-file-if-exists=.env src/api.ts",
    "test": "node --import tsx --test evals/evaluators.test.ts evals/guardrails/*.test.ts src/agent/tools/*.test.ts src/api.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "node --env-file-if-exists=.env --import tsx evals/run.ts",
    "eval:mock": "node --env-file-if-exists=.env --import tsx evals/run.ts --mock",
    "eval:local": "node --import tsx evals/run.ts --mock --local",
    "eval:guardrails": "node --env-file-if-exists=.env --import tsx evals/guardrails/run.ts",
    "eval:guardrails:mock": "node --env-file-if-exists=.env --import tsx evals/guardrails/run.ts --mock",
    "eval:guardrails:local": "node --import tsx evals/guardrails/run.ts --mock --local"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.87",
    "@fission-ai/openspec": "^1.14.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.131",
    "dotenv": "^18.0.6",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lmnr-ai/lmnr": "^0.8.49",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
