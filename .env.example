OPENAI_API_KEY=sk-...
# TypeSafe Jev API key for validating job descriptions before analysis
TYPESAFE_API_KEY=
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Folder where the agent saves the analysis JSON files (relative to the project root or absolute)
OUTPUT_DIR=./output

# Laminar project API key (required for pnpm eval and pnpm eval:mock)
LMNR_PROJECT_API_KEY=

# Optional: only needed when explicitly invoking the standalone web search tool.
# The job-description agent and existing evaluations do not use this tool yet.
TAVILY_API_KEY=

# Private HTTP API used by career-intel-server
JOB_AGENT_TOKEN=
JOB_AGENT_HOST=127.0.0.1
JOB_AGENT_PORT=3002
